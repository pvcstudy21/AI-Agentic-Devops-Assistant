# Local Ollama server and model. The model must support tool calling.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Paths are relative to the repository root unless absolute paths are supplied.
KNOWLEDGE_DIR=knowledge
SERVICES_CONFIG=config/services.json

# Optional: controls how many seconds a health-check connection may take.
TOOL_TIMEOUT_SECONDS=5
